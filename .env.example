# Скопируйте в .env и заполните реальными значениями. .env никогда не коммитится
# (CLAUDE.md, «Незыблемые правила», п.1) и не используется контейнерами до тех
# пор, пока не создан вручную.

# Ключ Anthropic API. Читается ТОЛЬКО сервером (reflection-worker), никогда —
# фронтендом (п.2). До фазы 6 боевые LLM-вызовы запрещены (п.7), рефлексия замокана.
ANTHROPIC_API_KEY=

# Пароль пользователя postgres в docker-compose (сервис не публикует порт наружу).
POSTGRES_PASSWORD=

# Окружение: development | production
AURWIN_ENV=development
