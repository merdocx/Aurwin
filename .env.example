# Скопируйте в .env и заполните реальными значениями. .env никогда не коммитится
# (CLAUDE.md, «Незыблемые правила», п.1) и не используется контейнерами до тех
# пор, пока не создан вручную.

# Ключ Anthropic API. Читается ТОЛЬКО сервером (reflection-worker), никогда —
# фронтендом (п.2). До фазы 6 боевые LLM-вызовы запрещены (п.7), рефлексия замокана.
ANTHROPIC_API_KEY=

# Пароль пользователя postgres в docker-compose (сервис не публикует порт наружу).
POSTGRES_PASSWORD=

# Пароль администратора Grafana (фаза 7 «Эксплуатация», ТЗ 6.1/А.7).
# Дашборд доступен только на 127.0.0.1:3001 — см. docker-compose.yml.
GRAFANA_ADMIN_PASSWORD=

# Окружение: development | production
AURWIN_ENV=development

# Строка подключения к Postgres для services/db (миграции, скрипты
# обслуживания) при запуске ВНЕ docker-compose (с хоста). Внутри
# docker-compose сервисы будут подключаться по имени "postgres" через
# отдельные переменные PG* (см. services/db/README.md), без публикации
# порта наружу.
# DATABASE_URL=postgres://aurwin:<POSTGRES_PASSWORD>@localhost:5432/aurwin
