[Unit]
Description=Aurwin — api-gateway (WebSocket/REST, read-only, ТЗ А.1, А.6, А.7)
Documentation=file:///opt/aurwin/ops/README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/aurwin
ExecStart=/usr/bin/docker compose up -d api-gateway
ExecStop=/usr/bin/docker compose stop api-gateway
TimeoutStartSec=120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
