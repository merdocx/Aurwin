[Unit]
Description=Aurwin — reflection-worker (очередь LLM-рефлексий, ТЗ 7.3, А.7)
Documentation=file:///opt/aurwin/ops/README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/aurwin
ExecStart=/usr/bin/docker compose up -d reflection-worker
ExecStop=/usr/bin/docker compose stop reflection-worker
TimeoutStartSec=120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
