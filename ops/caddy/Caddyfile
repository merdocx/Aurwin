# Caddy — единственный сервис, публично слушающий 80/443.
# TLS Let's Encrypt выпускается и обновляется автоматически (ACME HTTP-01).
#
# Маршрутизация: /ws и /api/* → api-gateway; остальное → frontend (статика).

# www → apex
www.aurwin.ru {
	redir https://aurwin.ru{uri} permanent
}

aurwin.ru {
	encode gzip

	# Access-лог в stdout JSON — ротация через docker json-file (max-size/max-file).
	log {
		output stdout
		format json
	}

	# Базовые security headers (P2 hardening).
	header {
		Content-Language "ru"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'"
	}

	# Caddy сам выставляет X-Forwarded-For; api-gateway читает его только
	# от peer из docker-сети (см. services/api-gateway/src/ip.ts), иначе
	# лимит 3 WS/IP схлопывается в один общий бакет на весь сайт.
	handle /ws {
		reverse_proxy api-gateway:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle /ws/* {
		reverse_proxy api-gateway:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle /api/* {
		reverse_proxy api-gateway:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy frontend:5173 {
			# serve/vite не должны видеть Host вида frontend:5173
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
